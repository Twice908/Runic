# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/pulse

# Redis
REDIS_URL=redis://localhost:6379

# Clerk Auth
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (email alerts)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=alerts@yourdomain.com

# Ingestion API
INGESTION_API_URL=http://localhost:3001
API_KEY_SECRET=change_me_in_production_32_chars_min

# Rate Limiter service — used by apps/web proxy routes
# Base URL of apps/rate-limiter (must match RATE_LIMITER_PORT)
RATE_LIMITER_URL=http://localhost:3002

# Rate Limiter service (apps/rate-limiter, port 3002)
# Internal bearer token used by the dashboard to call /v1/rules and /v1/analytics.
# Generate with: openssl rand -hex 32
RATE_LIMITER_INTERNAL_TOKEN=

# Port the rate-limiter Fastify service listens on (default: 3002)
RATE_LIMITER_PORT=3002

# Override Redis URL for the rate-limiter if it uses a different instance.
# If unset, falls back to the shared REDIS_URL above.
RATE_LIMITER_REDIS_URL= http://localhost:3002
# RATE_LIMITER_URL = http://rate-limiter:3002

# How long (in seconds) active rule sets are cached in Redis before re-fetching from DB (default: 30)
RATE_LIMITER_RULE_CACHE_TTL=30

# Abort a /v1/check call and fail-open if it exceeds this many milliseconds (default: 10)
RATE_LIMITER_CHECK_TIMEOUT_MS=10

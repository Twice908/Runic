generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  clerkId   String    @unique
  plan      Plan      @default(FREE)
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id               String           @id @default(cuid())
  name             String
  apiKeyHash       String           @unique
  apiKeyPrefix     String
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  logs             RequestLog[]
  errors           ErrorEvent[]
  checks           UptimeCheck[]
  alerts           Alert[]
  alertEvents      AlertEvent[]
  rateLimitRules   RateLimitRule[]
  rateLimitEvents  RateLimitEvent[]
  driftEnvironments DriftEnvironment[]
  driftManifests   DriftManifest[]
  driftEvents      DriftEvent[]
  driftKeyMetas    DriftKeyMeta[]
  agentDefinitions AgentDefinition[]
  agentRuns        AgentRun[]
  createdAt        DateTime         @default(now())
}

model RequestLog {
  id           String   @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  method       String
  route        String
  statusCode   Int
  responseTime Int
  timestamp    DateTime

  // Composite PK required by TimescaleDB: every unique index must include
  // the partition column (timestamp). A plain @id on `id` alone would fail.
  @@id([id, timestamp])
}

model ErrorEvent {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  message     String
  stack       String?
  route       String
  statusCode  Int
  count       Int       @default(1)
  firstSeen   DateTime
  lastSeen    DateTime
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?

  @@unique([projectId, route, statusCode])
}

model UptimeCheck {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url          String
  status       String
  responseTime Int?
  checkedAt    DateTime
}

model Alert {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String       // "uptime" | "error_rate" | "response_time"
  threshold   Float
  channel     String       // "email" | "slack"
  destination String
  active      Boolean      @default(true)
  url         String?      // URL to ping for uptime alerts
  route       String?      // optional route filter for response_time alerts
  events      AlertEvent[]
}

model AlertEvent {
  id             String   @id @default(cuid())
  alertId        String
  projectId      String
  type           String
  triggeredValue Float
  threshold      Float
  message        String
  channel        String
  destination    String
  sentAt         DateTime @default(now())

  alert          Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model RateLimitRule {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  pathPattern    String
  limitKey       String
  limitKeyHeader String?
  limitCount     Int
  windowSecs     Int
  action         String
  priority       Int      @default(0)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, enabled])
}

model RateLimitEvent {
  id        String   @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ruleId    String
  limitKey  String
  path      String
  action    String
  timestamp DateTime @default(now())

  // Composite PK required by TimescaleDB: every unique index must include
  // the partition column (timestamp). A plain @id on `id` alone would fail.
  @@id([id, timestamp])
  @@index([projectId, timestamp])
  @@index([ruleId, timestamp])
}

model DriftEnvironment {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  isBaseline  Boolean         @default(false)
  driftScore  Int             @default(100)
  lastSeenAt  DateTime?
  createdAt   DateTime        @default(now())

  manifests   DriftManifest[]
  events      DriftEvent[]
  keyMetas    DriftKeyMeta[]

  @@unique([projectId, name])
}

model DriftManifest {
  id             String           @id @default(cuid())
  environmentId  String
  environment    DriftEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keys           String[]
  agentVersion   String?
  agentId        String?
  capturedAt     DateTime

  @@index([environmentId, capturedAt])
}

model DriftEvent {
  id             String           @id @default(cuid())
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId  String
  environment    DriftEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  keyName        String
  driftType      DriftEventType
  detectedAt     DateTime         @default(now())
  resolvedAt     DateTime?
  resolved       Boolean          @default(false)

  @@index([projectId, detectedAt])
}

model DriftKeyMeta {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId  String?
  environment    DriftEnvironment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  keyName        String
  description    String?
  owner          String?
  rotationDays   Int?
  firstSeenAt    DateTime          @default(now())
  lastChangedAt  DateTime?
  isIgnored      Boolean           @default(false)
  ignoreReason   String?

  @@unique([projectId, keyName, environmentId])
}

enum DriftEventType {
  MISSING_KEY
  EXTRA_KEY
  STALE_ROTATION
  KEY_RESTORED
}

// ── PAO: Pulse Agent Observe ─────────────────────────────────────────────────

model AgentDefinition {
  id        String   @id @default(cuid())
  projectId String
  name      String
  role      String?
  model     String?
  createdAt DateTime @default(now())

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  spans   AgentSpan[]

  @@unique([projectId, name])
  @@index([projectId])
}

model AgentRun {
  id           String    @id @default(cuid())
  projectId    String
  task         String
  status       String    @default("running")
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  totalTokens  Int?
  totalCostUsd Decimal?  @db.Decimal(10, 6)
  metadata     Json?

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  spans   AgentSpan[]

  @@index([projectId, startedAt])
}

model AgentSpan {
  id                String   @default(cuid())
  runId             String
  projectId         String
  agentDefinitionId String?
  parentSpanId      String?
  spanType          String
  name              String
  startedAt         DateTime
  endedAt           DateTime?
  durationMs        Int?
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  costUsd           Decimal? @db.Decimal(10, 6)
  model             String?
  inputPreview      String?  @db.Text
  outputPreview     String?  @db.Text
  statusCode        String?
  errorMessage      String?
  metadata          Json?

  run             AgentRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  agentDefinition AgentDefinition? @relation(fields: [agentDefinitionId], references: [id], onDelete: SetNull)

  // Composite PK required by TimescaleDB: every unique index must include
  // the partition column (startedAt). A plain @id on `id` alone would fail.
  @@id([id, startedAt])
  @@index([runId, startedAt])
  @@index([projectId, startedAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  clerkId   String    @unique
  plan      Plan      @default(FREE)
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id               String           @id @default(cuid())
  name             String
  apiKeyHash       String           @unique
  apiKeyPrefix     String
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  logs             RequestLog[]
  errors           ErrorEvent[]
  checks           UptimeCheck[]
  alerts           Alert[]
  alertEvents      AlertEvent[]
  rateLimitRules   RateLimitRule[]
  rateLimitEvents  RateLimitEvent[]
  createdAt        DateTime         @default(now())
}

model RequestLog {
  id           String   @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  method       String
  route        String
  statusCode   Int
  responseTime Int
  timestamp    DateTime

  // Composite PK required by TimescaleDB: every unique index must include
  // the partition column (timestamp). A plain @id on `id` alone would fail.
  @@id([id, timestamp])
}

model ErrorEvent {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  message     String
  stack       String?
  route       String
  statusCode  Int
  count       Int       @default(1)
  firstSeen   DateTime
  lastSeen    DateTime
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?

  @@unique([projectId, route, statusCode])
}

model UptimeCheck {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url          String
  status       String
  responseTime Int?
  checkedAt    DateTime
}

model Alert {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String       // "uptime" | "error_rate" | "response_time"
  threshold   Float
  channel     String       // "email" | "slack"
  destination String
  active      Boolean      @default(true)
  url         String?      // URL to ping for uptime alerts
  route       String?      // optional route filter for response_time alerts
  events      AlertEvent[]
}

model AlertEvent {
  id             String   @id @default(cuid())
  alertId        String
  projectId      String
  type           String
  triggeredValue Float
  threshold      Float
  message        String
  channel        String
  destination    String
  sentAt         DateTime @default(now())

  alert          Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model RateLimitRule {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  pathPattern    String
  limitKey       String
  limitKeyHeader String?
  limitCount     Int
  windowSecs     Int
  action         String
  priority       Int      @default(0)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, enabled])
}

model RateLimitEvent {
  id        String   @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ruleId    String
  limitKey  String
  path      String
  action    String
  timestamp DateTime @default(now())

  // Composite PK required by TimescaleDB: every unique index must include
  // the partition column (timestamp). A plain @id on `id` alone would fail.
  @@id([id, timestamp])
  @@index([projectId, timestamp])
  @@index([ruleId, timestamp])
}
